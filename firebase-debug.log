[debug] [2026-02-14T18:03:36.143Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/churchvote-ba9c1/rulesets {"name":"projects/churchvote-ba9c1/rulesets/f1d178bb-913c-4c28-8e03-c23195af80ae","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Poll documents: readable by anyone, but only admin/server may modify\r\n    match /artifacts/{appId}/public/data/polls/{pollId} {\r\n      allow read: if true;\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    // Votes collections follow the naming convention: poll_{pollId}_votes\r\n    // Each vote document must be written as a document with ID == userId\r\n    match /artifacts/{appId}/public/data/{votesCollection}/{voteId} {\r\n      allow read: if true;\r\n\r\n      allow create: if isValidVoteCreate(votesCollection, voteId);\r\n\r\n      // Disallow client-side updates/deletes to prevent tampering\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    function isValidVoteCreate(votesCollection, voteId) {\r\n      // Basic collection name validation\r\n      return votesCollection.matches('^poll_.*_votes$')\r\n        // Required fields and basic types\r\n        && request.resource.data.keys().hasAll(['userId', 'method', 'votedAt'])\r\n        && request.resource.data.userId is string\r\n        && request.resource.data.method is string\r\n        && request.resource.data.votedAt is timestamp\r\n        // The client must write the vote document with the ID equal to the user identity\r\n        && voteId == request.resource.data.userId\r\n        // Either authenticated user (anonymous or otherwise) and UID matches,\r\n        // or unauthenticated QR-based submission with a token-like userId.\r\n        && (\r\n          (request.auth != null && request.resource.data.userId == request.auth.uid)\r\n          || (\r\n              // Allow QR-based submissions even if the client happens to be\r\n              // authenticated (e.g. anon auth). We still require the method\r\n              // to be 'qr' and a token-like userId to reduce spoofing.\r\n              request.resource.data.method == 'qr'\r\n              // crude token shape check: length > 8\r\n              && request.resource.data.userId.size() > 8\r\n            )\r\n        );\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-02-14T18:03:36.613391Z","metadata":{"services":["cloud.firestore"]}}
